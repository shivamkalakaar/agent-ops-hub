OPENROUTER_API_KEY=
# Supabase: Project Settings → Database → Connection string → "Session pooler" (IPv4; GitHub Actions has no IPv6).
# Leave unset locally to use ./local.db (SQLite).
DATABASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# Substack newsroom images (Supabase Storage, bucket created by policies.sql). Unset locally: images go to ./out/img.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=
